# See https://git-scm.com/docs/gitattributes for more about git attribute files.

# Executable scripts must stay LF or their shebang breaks on Linux/CI.
bin/* eol=lf

# SKILL.md files are generated by bin/build-skills from SKILL.src.md +
# skills/shared/common.md. Mark them generated (collapsed in diffs, excluded
# from language stats) and pin them to LF so the committed artifacts are
# byte-identical regardless of who rebuilt them.
skills/**/SKILL.md linguist-generated eol=lf
