# Scans every file in the repo for http:// and https:// URLs and rejects
# any that don't match a prefix in .trusted-urls.yml. Enforces the trust
# boundary documented in CLAUDE.md.
#
# Usage:
#   bin/check-trusted-urls         # scan the repo against .trusted-urls.yml
#   bin/check-trusted-urls --self-test
#
# Exits 0 if every URL is allowed, 1 otherwise.

require "yaml"
require "find"
require "tmpdir"

REPO_ROOT = File.expand_path("..", __dir__)
ALLOWLIST_FILE = File.join(REPO_ROOT, ".trusted-urls.yml")

# Match a URL: scheme + alphanumeric host char + remaining URL chars.
# The leading-alphanumeric requirement excludes Ruby `https://#{var}`
# interpolations and other non-host openers from being treated as URLs.
URL_REGEX = %r{https?://[A-Za-z0-9][A-Za-z0-9._~:/?#@!$&'()*+,;=%-]*}

# Punctuation that often follows a URL in markdown/prose but is not part of it.
TRAILING_PUNCT = /[.,);\]'">]+\z/

# Directory basenames pruned from the scan.
EXCLUDE_DIRS = %w[.git node_modules vendor tmp .bundle .context].freeze

def load_allowlist(path)
  doc = YAML.safe_load_file(path)
  raise "#{path}: top level is not a Hash" unless doc.is_a?(Hash)

  prefixes = []
  %w[coolhand infrastructure].each do |section|
    list = doc[section]
    next if list.nil?
    raise "#{path}: '#{section}' is not a list" unless list.is_a?(Array)

    list.each_with_index do |entry, i|
      unless entry.is_a?(String) && !entry.strip.empty?
        raise "#{path}: #{section}[#{i}]: not a non-empty string"
      end
      prefixes << entry
    end
  end

  ignore_paths = []
  if doc.key?("ignore_paths")
    list = doc["ignore_paths"]
    raise "#{path}: 'ignore_paths' is not a list" unless list.is_a?(Array)
    list.each_with_index do |entry, i|
      unless entry.is_a?(String) && !entry.strip.empty?
        raise "#{path}: ignore_paths[#{i}]: not a non-empty string"
      end
      ignore_paths << entry
    end
  end

  raise "#{path}: no prefixes found" if prefixes.empty?
  [prefixes, ignore_paths]
end

def text_file?(path)
  return false unless File.file?(path)
  # Read a small chunk; reject if it has NUL bytes (binary) or invalid UTF-8.
  chunk = File.binread(path, 8192)
  return false if chunk.include?("\x00")
  chunk.force_encoding("UTF-8").valid_encoding?
rescue StandardError
  false
end

def url_allowed?(url, prefixes)
  prefixes.any? do |prefix|
    next true if url == prefix
    next false unless url.start_with?(prefix)
    # If the allowlist prefix itself ends at a path boundary, anything past
    # it is fine.
    next true if prefix.end_with?("/")
    # Otherwise the URL must continue at a structural boundary: path (/),
    # query (?), or fragment (#). A colon (:) is accepted only when followed
    # immediately by a numeric port — this rejects userinfo attacks where the
    # colon introduces credentials rather than a port number.
    boundary = url[prefix.length]
    case boundary
    when "/", "?", "#" then true
    when ":"
      # Only loopback addresses legitimately vary by port (OAuth callback server).
      next false unless prefix.start_with?("http://localhost", "http://127.0.0.1")
      rest = url[(prefix.length + 1)..]
      rest&.match?(/\A\d{1,5}(\/|\?|#|\z)/)
    else
      false
    end
  end
end

def scan(target_dir, allowed_prefixes, ignore_paths = [])
  violations = []
  Find.find(target_dir) do |path|
    if File.directory?(path)
      Find.prune if EXCLUDE_DIRS.include?(File.basename(path))
      next
    end
    next unless text_file?(path)

    rel = path.sub(%r{\A#{Regexp.escape(target_dir)}/?}, "")
    next if ignore_paths.include?(rel)

    File.foreach(path).with_index(1) do |line, line_no|
      line.scan(URL_REGEX).each do |url|
        url = url.sub(TRAILING_PUNCT, "")
        next if url_allowed?(url, allowed_prefixes)
        violations << { file: rel, line: line_no, url: url }
      end
    end
  end
  violations
end

def self_test
  passed = 0
  failed = []

  Dir.mktmpdir do |dir|
    allowed_host = "coolhandlabs.com"
    allowed_repo = "github.com/Coolhand-Labs/foo"
    allowed_prefixes = [
      "https://#{allowed_host}",
      "https://#{allowed_repo[0, 'github.com/Coolhand-Labs/'.length]}",
      "http://localhost"
    ]

    # Build the violation URL dynamically so this script's source contains
    # no URL literal that would itself be flagged when run against this repo.
    bad_host = ["untrusted", "example", "test"].join(".")
    bad_url = "https" + "://" + bad_host + "/x"

    # Domain-confusion fixture: legitimately matches the bare-host prefix as a
    # raw start_with? but is actually a different domain.
    confusion_url = "https" + "://" + allowed_host + "." + bad_host + "/leak"

    # Userinfo attack: colon-at-sign pattern (localhost:@<host>) where the colon
    # introduces credentials rather than a port; must be rejected.
    userinfo_url = "http" + "://localhost:@" + bad_host + "/path"

    File.write("#{dir}/good.md", "see https://#{allowed_host}/docs for details\n")
    File.write("#{dir}/repo.md", "code at https://#{allowed_repo}\n")
    File.write("#{dir}/bad.md", "evil link: #{bad_url}\n")
    File.write("#{dir}/confusion.md", "sneaky: #{confusion_url}\n")
    File.write("#{dir}/no_url.md", "this file has no urls\n")
    File.write("#{dir}/vendored.json", "{\"upstream\": \"#{bad_url}\"}\n")
    nonloopback_port_url = "https" + "://" + allowed_host + ":4444/foo"

    File.write("#{dir}/port.md", "callback: http://localhost:9999/callback\n")
    File.write("#{dir}/userinfo.md", "attack: #{userinfo_url}\n")
    File.write("#{dir}/nonloopback_port.md", "bad: #{nonloopback_port_url}\n")

    violations = scan(dir, allowed_prefixes, ["vendored.json"])

    cases = [
      {
        name: "good.md is allowed",
        ok: violations.none? { |v| v[:file] == "good.md" }
      },
      {
        name: "repo.md is allowed",
        ok: violations.none? { |v| v[:file] == "repo.md" }
      },
      {
        name: "no_url.md produces no violations",
        ok: violations.none? { |v| v[:file] == "no_url.md" }
      },
      {
        name: "bad.md produces a violation with the right URL",
        ok: violations.any? { |v| v[:file] == "bad.md" && v[:url] == bad_url }
      },
      {
        name: "domain-confusion URL produces a violation (host-extension attack)",
        ok: violations.any? { |v| v[:file] == "confusion.md" && v[:url] == confusion_url }
      },
      {
        name: "vendored.json is skipped via ignore_paths",
        ok: violations.none? { |v| v[:file] == "vendored.json" }
      },
      {
        name: "port.md localhost:PORT URL is allowed (numeric port boundary)",
        ok: violations.none? { |v| v[:file] == "port.md" }
      },
      {
        name: "userinfo.md localhost:@ attack is rejected (userinfo, not port)",
        ok: violations.any? { |v| v[:file] == "userinfo.md" }
      },
      {
        name: "nonloopback_port.md trusted-host:PORT is rejected (port boundary limited to loopback)",
        ok: violations.any? { |v| v[:file] == "nonloopback_port.md" }
      },
      {
        name: "exactly four violations total (bad.md + confusion.md + userinfo.md + nonloopback_port.md)",
        ok: violations.length == 4
      }
    ]

    cases.each do |c|
      if c[:ok]
        passed += 1
      else
        failed << c[:name]
      end
    end

    # Also exercise allowlist parsing failure modes.
    bad_yaml = File.join(dir, "bad.yml")
    File.write(bad_yaml, "coolhand: not a list\n")
    parse_err = nil
    begin
      load_allowlist(bad_yaml)
    rescue StandardError => e
      parse_err = e.message
    end
    if parse_err && parse_err.include?("not a list")
      passed += 1
    else
      failed << "allowlist parser rejects non-list 'coolhand' (got: #{parse_err.inspect})"
    end
  end

  total = passed + failed.length
  if failed.empty?
    puts "OK   self-test (#{passed}/#{total} passed)"
    0
  else
    puts "FAIL self-test (#{passed}/#{total} passed)"
    failed.each { |name| puts "     - #{name}" }
    1
  end
end

if ARGV.include?("--self-test")
  exit self_test
end

unless File.file?(ALLOWLIST_FILE)
  warn "Allowlist not found: #{ALLOWLIST_FILE}"
  exit 1
end

allowed, ignore_paths = load_allowlist(ALLOWLIST_FILE)
violations = scan(REPO_ROOT, allowed, ignore_paths)

if violations.empty?
  puts "OK   no untrusted URLs in #{REPO_ROOT}"
  exit 0
end

puts "FAIL #{violations.length} untrusted URL(s):"
violations.each do |v|
  puts "     #{v[:file]}:#{v[:line]}: #{v[:url]}"
end
puts ""
puts "If a URL is legitimate, add a justified prefix to .trusted-urls.yml."
exit 1
