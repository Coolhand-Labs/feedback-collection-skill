#!/usr/bin/env ruby
# frozen_string_literal: true

# build-skills — assemble each skill's committed SKILL.md from its source.
#
# Source of truth:
#   skills/<name>/SKILL.src.md   the hand-edited recipe (frontmatter + body)
#   skills/shared/common.md      prose injected into skills that opt in
#
# Output (generated — do not edit by hand):
#   skills/<name>/SKILL.md       frontmatter + [common.md] + body
#
# A source opts into common.md by adding `shared_common: true` to its
# frontmatter. Skills that don't need the shared provider-detection prose
# (e.g. wildcard-tool) omit the flag and get their body only.
#
# common.md is injected AFTER the YAML frontmatter, because the frontmatter
# block must remain the first thing in the file or skill discovery breaks.
#
# Modes:
#   bin/build-skills              build every SKILL.md from its SKILL.src.md
#   bin/build-skills --check      build in memory; fail if any committed
#                                 SKILL.md is missing or out of date
#   bin/build-skills --self-test  run the built-in test cases

REPO_ROOT = File.expand_path("..", __dir__)
COMMON_PATH = File.join(REPO_ROOT, "skills", "shared", "common.md")
SRC_GLOB = File.join(REPO_ROOT, "skills", "*", "SKILL.src.md")

BANNER_WITH_COMMON =
  "<!-- Generated by bin/build-skills from SKILL.src.md + skills/shared/common.md. " \
  "Do not edit by hand; edit the source files and re-run bin/build-skills. -->"

BANNER_WITHOUT_COMMON =
  "<!-- Generated by bin/build-skills from SKILL.src.md. " \
  "Do not edit by hand; edit the source file and re-run bin/build-skills. -->"

# Collapse CRLF / CR line endings to LF so the script behaves identically
# regardless of how the repo was checked out (Windows checkouts use CRLF).
def normalize_newlines(text)
  text.gsub("\r\n", "\n").tr("\r", "\n")
end

def read_text(path)
  normalize_newlines(File.read(path))
end

# Split "---\n...\n---\n<body>" into [frontmatter_including_fences, body].
def split_frontmatter(text, label)
  unless text.start_with?("---\n")
    raise "#{label}: missing YAML frontmatter (file must start with '---')"
  end

  match = text.match(/\A(---\n.*?\n)(---[ \t]*\n?)(.*)\z/m)
  raise "#{label}: unterminated YAML frontmatter (no closing '---')" unless match

  frontmatter = match[1] + match[2]
  body = match[3]
  [frontmatter, body]
end

# Frontmatter opts into common.md with a `shared_common: true` line. Absence
# (or `false`) means the skill doesn't want the shared prose.
def wants_common?(frontmatter)
  frontmatter.match?(/^shared_common:\s*true\s*$/)
end

# Produce the final SKILL.md text for one source file.
def assemble(src_text, common_text, label)
  frontmatter, body = split_frontmatter(src_text, label)

  parts = [frontmatter.rstrip]
  if wants_common?(frontmatter)
    parts << BANNER_WITH_COMMON
    parts << common_text.strip
  else
    parts << BANNER_WITHOUT_COMMON
  end
  parts << body.strip
  "#{parts.join("\n\n")}\n"
end

def src_to_out(src_path)
  File.join(File.dirname(src_path), "SKILL.md")
end

def load_common
  unless File.file?(COMMON_PATH)
    raise "shared prose not found: #{COMMON_PATH}"
  end

  read_text(COMMON_PATH)
end

def source_paths
  paths = Dir.glob(SRC_GLOB).sort
  raise "no SKILL.src.md files found under skills/*/" if paths.empty?

  paths
end

def relative(path)
  path.sub("#{REPO_ROOT}/", "")
end

def build
  common = load_common
  source_paths.each do |src|
    out = src_to_out(src)
    File.write(out, assemble(read_text(src), common, relative(src)))
    puts "BUILT #{relative(out)}"
  end
  0
end

def check
  common = load_common
  stale = []

  source_paths.each do |src|
    out = src_to_out(src)
    expected = assemble(read_text(src), common, relative(src))
    actual = File.file?(out) ? read_text(out) : nil

    if actual == expected
      puts "OK    #{relative(out)}"
    else
      stale << relative(out)
      puts(actual.nil? ? "MISSING #{relative(out)}" : "STALE   #{relative(out)}")
    end
  end

  if stale.empty?
    0
  else
    warn ""
    warn "#{stale.size} SKILL.md file(s) out of date. Run: bin/build-skills"
    1
  end
end

def self_test
  common = "## Shared\n\nshared body line.\n"

  src = <<~SRC
    ---
    name: demo
    description: a demo skill
    shared_common: true
    ---

    # Demo

    Real body content.
  SRC

  cases = []

  built = assemble(src, common, "demo")
  cases << ["frontmatter stays first", built.start_with?("---\nname: demo")]
  cases << ["common injected after frontmatter", built.include?("---\n\n#{BANNER_WITH_COMMON}\n\n## Shared")]
  cases << ["original body preserved", built.include?("Real body content.")]
  cases << ["common appears before body", built.index("shared body line.") < built.index("Real body content.")]
  cases << ["ends with single newline", built.end_with?("content.\n") && !built.end_with?("\n\n")]

  crlf_built = assemble(normalize_newlines(src.gsub("\n", "\r\n")), common, "crlf")
  cases << ["CRLF source builds identically to LF", crlf_built == built]

  no_common_src = <<~SRC
    ---
    name: opt-out-demo
    description: a demo skill that opts out of common.md
    ---

    # Opt-out Demo

    Real body content.
  SRC

  no_common_built = assemble(no_common_src, common, "opt-out-demo")
  cases << ["skill without shared_common gets no common text", !no_common_built.include?("shared body line.")]
  cases << ["skill without shared_common gets the no-common banner", no_common_built.include?(BANNER_WITHOUT_COMMON)]
  cases << ["skill without shared_common keeps its frontmatter unmodified", no_common_built.include?("---\nname: opt-out-demo\ndescription: a demo skill that opts out of common.md\n---")]

  missing_fm =
    begin
      assemble("no frontmatter here\n", common, "bad")
      false
    rescue RuntimeError => e
      e.message.include?("missing YAML frontmatter")
    end
  cases << ["rejects file without frontmatter", missing_fm]

  unterminated =
    begin
      assemble("---\nname: x\nbody with no closing fence\n", common, "bad")
      false
    rescue RuntimeError => e
      e.message.include?("unterminated")
    end
  cases << ["rejects unterminated frontmatter", unterminated]

  failed = cases.reject { |(_, ok)| ok }
  passed = cases.size - failed.size

  if failed.empty?
    puts "OK   self-test (#{passed}/#{cases.size} passed)"
    0
  else
    puts "FAIL self-test (#{passed}/#{cases.size} passed)"
    failed.each { |(name, _)| puts "     - #{name}" }
    1
  end
end

mode = ARGV[0]

exit(
  case mode
  when nil then build
  when "--check" then check
  when "--self-test" then self_test
  else
    warn "usage: bin/build-skills [--check | --self-test]"
    2
  end
)
